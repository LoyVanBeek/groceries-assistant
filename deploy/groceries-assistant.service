# groceries-assistant, supervised by systemd on top of docker compose.
# Rendered and installed by deploy/setup.sh, which substitutes @REPO_DIR@.
# ExecStart runs `docker compose up` in the foreground so the container's
# stdout/stderr streams into the journal:
#
#   sudo journalctl -u groceries-assistant.service -f
#
# App dependencies (tesseract, xvfb, chromium) live in the image; the host
# only needs docker. The service runs as root: on hosts where docker needs
# sudo (rootful daemon, user not in the docker group) a non-root unit cannot
# reach the docker socket, and the container runs as root anyway. Stop/start
# via systemctl: `docker compose up -d` by hand would fight this unit over
# the same containers.

[Unit]
Description=groceries-assistant web UI (docker compose)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
