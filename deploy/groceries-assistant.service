# groceries-assistant, supervised by systemd on top of docker compose.
# Rendered and installed by deploy/setup.sh, which substitutes @USER@ and
# @REPO_DIR@. The ExecStart runs `docker compose up` in the foreground so the
# container's stdout/stderr streams into the journal:
#
#   journalctl -u groceries-assistant.service -f
#
# App dependencies (tesseract, xvfb, chromium) live in the image; the host
# only needs docker. Stop/start via systemctl: `docker compose up -d` by hand
# would fight this unit over the same containers.

[Unit]
Description=groceries-assistant web UI (docker compose)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
